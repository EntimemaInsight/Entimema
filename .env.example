# Auth.js private-beta workspace (required server-side values)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
WORKSPACE_ALLOWED_EMAILS=

# OpenAI classifier fallback (both required to enable the fallback)
OPENAI_API_KEY=
OPENAI_DOCUMENT_CLASSIFIER_MODEL=
OPENAI_DOCUMENT_CLASSIFIER_TIMEOUT_MS=45000
OPENAI_DOCUMENT_CLASSIFIER_MAX_ATTEMPTS=2

# Classifier execution controls
# Fixed temporary file boundary: 4.5 MB (4,500,000 bytes). This stays below
# Vercel's 4.5 MiB (4,718,592-byte) whole-request limit after multipart framing.
# This is intentionally not runtime-configurable.
DOCUMENT_CLASSIFIER_LOCAL_FAST_PATH_THRESHOLD=0.92
DOCUMENT_CLASSIFIER_RATE_LIMIT_MAX=20
DOCUMENT_CLASSIFIER_RATE_LIMIT_WINDOW_MS=60000

# Private S3-compatible temporary upload store (all required for direct upload).
# The endpoint must be an HTTPS bucket endpoint; the bucket must block public access.
DOCUMENT_UPLOAD_S3_ENDPOINT=
DOCUMENT_UPLOAD_S3_REGION=
DOCUMENT_UPLOAD_S3_ACCESS_KEY_ID=
DOCUMENT_UPLOAD_S3_SECRET_ACCESS_KEY=
# Optional when AUTH_SECRET is configured; dedicated rotation is recommended.
DOCUMENT_UPLOAD_REFERENCE_SECRET=

# Rate limiting above is per-process best effort only. Production distributed
# enforcement requires a shared provider; none is configured in this repository.

# Durable Financial Intelligence persistence (required in production).
# Supabase project REST URL, e.g. https://PROJECT.supabase.co. Apply migrations/001_financial_runs.sql first.
FINANCIAL_DATABASE_REST_URL=
# Server-only service-role credential. Never prefix with NEXT_PUBLIC_ or expose to the browser.
FINANCIAL_DATABASE_SERVICE_KEY=

# Whole-statement semantic resolver (server-only; OPENAI_API_KEY is shared securely).
FINANCIAL_SEMANTIC_RESOLVER_ENABLED=false
FINANCIAL_SEMANTIC_MODEL=gpt-5-mini
FINANCIAL_SEMANTIC_RESOLVER_VERSION=2026-09-04
FINANCIAL_SEMANTIC_TIMEOUT_MS=30000
FINANCIAL_SEMANTIC_MAX_ATTEMPTS=2
FINANCIAL_SEMANTIC_MAX_ROWS=120
FINANCIAL_SEMANTIC_MAX_CONTEXT_CHARS=32000
# Acceptance remains server-defined (mapping-confidence.v1 high band = 0.68); it is intentionally not configurable.
